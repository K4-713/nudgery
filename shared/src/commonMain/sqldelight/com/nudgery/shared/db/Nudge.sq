CREATE TABLE Nudge (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    isEnabled INTEGER NOT NULL DEFAULT 1,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

selectAll:
SELECT * FROM Nudge ORDER BY createdAt ASC;

selectById:
SELECT * FROM Nudge WHERE id = :id;

insert:
INSERT INTO Nudge (id, name, isEnabled, createdAt, updatedAt)
VALUES (:id, :name, :isEnabled, :createdAt, :updatedAt);

update:
UPDATE Nudge SET name = :name, isEnabled = :isEnabled, updatedAt = :updatedAt WHERE id = :id;

setEnabled:
UPDATE Nudge SET isEnabled = :isEnabled, updatedAt = :updatedAt WHERE id = :id;

delete:
DELETE FROM Nudge WHERE id = :id;
