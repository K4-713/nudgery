<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night-mode override: dark window background prevents a white flash on lock/unlock
         before Compose draws its first frame. Mirrors the structure of values/themes.xml. -->
    <style name="Theme.Nudgery" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
